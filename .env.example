# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase anon key (public). With RLS enabled this key can no longer read or
# write any table; all data access goes through the server using the key below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role key — SERVER ONLY, never expose. Used by server actions and the
# PIN routes to access the database (bypasses RLS). Get it from
# Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Secret used to sign the session cookie (HMAC-SHA256). Use a long random
# string, e.g. `openssl rand -base64 48`. Minimum 16 characters.
SESSION_SECRET=your_long_random_session_secret
