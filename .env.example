NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Secreto para firmar la cookie de sesión del PIN (HMAC). OBLIGATORIO en producción.
# Genera uno con: openssl rand -hex 32
PIN_SESSION_SECRET=your_random_32_byte_hex_secret

# Service-role key de Supabase (server-only, NUNCA NEXT_PUBLIC). Necesaria para
# los server actions de datos y las rutas /api/pin/* cuando RLS está habilitado
# (migraciones 005 y 006). Sin esta key, con RLS activo la app no lee datos.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
