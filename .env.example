NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Secreto para firmar la cookie de sesión del PIN (HMAC). OBLIGATORIO en producción.
# Genera uno con: openssl rand -hex 32
PIN_SESSION_SECRET=your_random_32_byte_hex_secret

# Service-role key de Supabase (server-only, NUNCA NEXT_PUBLIC). Necesaria para
# que las rutas /api/pin/* accedan a pin_auth cuando RLS está habilitado (migración 005).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
